{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Hospitality Analytics",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "infrastructure.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "jinja": true,
      "justMyCode": true
    }
  ]
}
